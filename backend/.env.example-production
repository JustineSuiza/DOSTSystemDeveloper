# ---------------------------------------------------------------------
# DOST Backend - PRODUCTION environment reference
# ---------------------------------------------------------------------
# Set these as real environment variables on Render (Dashboard ->
# your web service -> Environment). Never commit real credentials.
#
# Railway MySQL host/credentials go here. Values shown are placeholders.

CI_ENVIRONMENT = production

# Must point to your Render service URL, with trailing slash
app.baseURL = https://dost-backend.onrender.com/

# Railway MySQL (create the DB from dost_system_schema.sql first)
database.default.hostname = YOUR_RAILWAY_MYSQL_HOST
database.default.database = railway
database.default.username = root
database.default.password = YOUR_RAILWAY_MYSQL_PASSWORD
database.default.DBDriver = MySQLi
database.default.port = 3306

# Optional: keep logs at errors+ instead of everything in production
logger.threshold = 4